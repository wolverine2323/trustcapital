# Supabase (Project Settings → API). La clave pública puede exponerse: la seguridad depende de RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# URL pública del sitio (enlaces de confirmación y recuperación)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# SUPABASE_SERVICE_ROLE_KEY no es necesaria en la Fase 1. Nunca la expongas con prefijo NEXT_PUBLIC_.
